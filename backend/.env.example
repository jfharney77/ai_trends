# ---------------------------------------------------------------- LLM provider
# openrouter (default) | ollama | anthropic | openai
# Can be overridden per run from the web UI.
LLM_PROVIDER=openrouter

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama running on the Windows host. From WSL, localhost is NOT the host;
# use the gateway IP:  ip route show default | awk '{print $3; exit}'
OLLAMA_BASE_URL=http://172.30.48.1:11434
OLLAMA_MODEL=hermes3:8b

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120

# ---------------------------------------------------------------- Web search
# auto (Tavily if TAVILY_API_KEY is set, else DuckDuckGo) | ddgs | tavily
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SEARCH_RESULTS_PER_QUERY=6
# d = past day, w = past week, m = past month
SEARCH_TIMELIMIT=w

# ---------------------------------------------------------------- Daily email
# Comma-separated recipients.
EMAIL_TO=jfharney@gmail.com
# Gmail: enable 2FA and create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER when blank.
EMAIL_FROM=
SMTP_USE_TLS=1
# Provider used by the cron digest; defaults to LLM_PROVIDER.
DIGEST_PROVIDER=
# When the cron digest fires (see scripts/install_cron.sh).
DIGEST_TZ=America/New_York
DIGEST_HOUR=8
